#!/bin/bash

ROOT="$(git rev-parse --show-toplevel)"

# Reject incident files with vague date patterns instead of real YYYY-MM-DD dates
BAD_PATTERNS="-early-|-mid-|-late-|-unknown-|-second-week-|-third-week-"
BAD_FILES=$(git diff --cached --name-only --diff-filter=A | grep '^docs/incidents/' | grep -E "$BAD_PATTERNS" || true)

if [ -n "$BAD_FILES" ]; then
    echo ""
    echo "ERROR: Incident files must have a real date (YYYY-MM-DD), not vague patterns."
    echo "Estimate the date and note it's an estimate in the Summary."
    echo ""
    echo "Rejected files:"
    echo "$BAD_FILES" | while read -r f; do echo "  $f"; done
    echo ""
    exit 1
fi

echo "Regenerating incident data files..."
python3 "$ROOT/scripts/generate_summary.py"

if [ $? -ne 0 ]; then
    echo "Failed to generate incidents summary"
    exit 1
fi

git add "$ROOT/docs/data/incidents-summary-citizens.json"
git add "$ROOT/docs/data/incidents-summary-immigrants.json"
git add "$ROOT/docs/data/incidents-summary-observers.json"
git add "$ROOT/docs/data/incidents-summary-schools-hospitals.json"
git add "$ROOT/docs/data/incidents-summary-response.json"
git add "$ROOT/docs/data/search-index.md"

# Regenerate tarball of all incident files
echo "Generating incidents tarball..."
bash "$ROOT/scripts/generate-tarball.sh"
git add "$ROOT/docs/mn-ice-witness-all-incidents.tar.gz"

# Cache bust: update ?v= parameters in index.html with current timestamp
TIMESTAMP=$(date +%s)
INDEX="$ROOT/docs/index.html"

if [ -f "$INDEX" ]; then
    echo "Cache busting index.html (v=$TIMESTAMP)..."
    sed -i '' "s/?v=[0-9]*/?v=$TIMESTAMP/g" "$INDEX"
    git add "$INDEX"
fi

exit 0
